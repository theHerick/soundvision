<Window x:Class="VisionBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LensLocalAPI - Google Lens &amp; Firebase Gateway"
        Height="840" Width="1140"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F12"
        Foreground="#E1E1E6">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#18181B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#27272A"/>
        <SolidColorBrush x:Key="AccentColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentHover" Color="#4F46E5"/>
        <SolidColorBrush x:Key="OnlineColor" Color="#10B981"/>
        <SolidColorBrush x:Key="OfflineColor" Color="#EF4444"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#09090B"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="LensLocalAPI" FontSize="20" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center"/>
                    <TextBlock Text="PRO" FontSize="11" FontWeight="Bold" Foreground="#10B981" Background="#064E3B" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="#27272A" CornerRadius="12" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource OfflineColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFirebaseOnline}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OnlineColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Firebase: " FontSize="12" Foreground="#A1A1AA" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FirebaseStatusDetail}" FontSize="12" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#27272A" CornerRadius="12" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource OfflineColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSseConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OnlineColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="SSE Stream: " FontSize="12" Foreground="#A1A1AA" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SseStatusDetail}" FontSize="12" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#27272A" CornerRadius="12" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource OfflineColor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLensReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OnlineColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="Lens: " FontSize="12" Foreground="#A1A1AA" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LensStatusDetail}" FontSize="12" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ToggleSettingsCommand}" Content="Configurar Firebase" Style="{StaticResource ModernButton}" Padding="10,5" FontSize="11" Margin="0,0,8,0"/>
                    <Button Command="{Binding CheckConnectionsCommand}" Content="Verificar Conexão" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FIREBASE SETTINGS DRAWER -->
        <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Configurar Firebase Realtime Database" FontSize="13" FontWeight="Bold" Foreground="#818CF8" Margin="0,0,0,12"/>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="URL do Database:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ConfigFirebaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Auth Token (Opcional):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ConfigAuthToken, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Caminho Requisições:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ConfigRequestsPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Caminho Fila:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ConfigQueuePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding ToggleSettingsCommand}" Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button Command="{Binding SaveSettingsCommand}" Content="Salvar e Conectar" Style="{StaticResource ModernButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Image Preview -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ÚLTIMA FOTO CAPTURADA" FontSize="12" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" VerticalAlignment="Stretch">
                        <Grid>
                            <Image Source="{Binding LastImageSource}" Stretch="Uniform" Margin="4"/>
                            <TextBlock Text="Nenhuma foto recebida ainda" Foreground="#52525B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastImageSource}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Grid Margin="0,2">
                            <TextBlock Text="REQUEST ID:" FontSize="11" Foreground="#71717A"/>
                            <TextBlock Text="{Binding LastRequestId}" FontSize="11" Foreground="#E4E4E7" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="DISPOSITIVO:" FontSize="11" Foreground="#71717A"/>
                            <TextBlock Text="{Binding LastDeviceId}" FontSize="11" Foreground="#E4E4E7" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="HORÁRIO:" FontSize="11" Foreground="#71717A"/>
                            <TextBlock Text="{Binding LastTimestamp}" FontSize="11" Foreground="#E4E4E7" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <TextBlock Text="TAMANHO:" FontSize="11" Foreground="#71717A"/>
                            <TextBlock Text="{Binding LastImageSize}" FontSize="11" Foreground="#E4E4E7" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: Recognition Results -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="RESULTADO DO RECONHECIMENTO" FontSize="12" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,16"/>

                        <TextBlock Text="OBJETO IDENTIFICADO (GOOGLE LENS)" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold"/>
                        <Border Background="#27272A" CornerRadius="6" Padding="12,10" Margin="0,6,0,16">
                            <TextBlock Text="{Binding LastObject}" FontSize="22" FontWeight="Bold" Foreground="#F4F4F5" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="COR PREDOMINANTE (ALGORITMO LOCAL)" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold"/>
                        <Border Background="#27272A" CornerRadius="6" Padding="12,8" Margin="0,6,0,16" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Cor: " FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LastColor}" FontSize="16" FontWeight="Bold" Foreground="#818CF8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DESCRIÇÃO &amp; DETALHES" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold"/>
                        <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                            <TextBlock Text="{Binding LastDescription}" FontSize="13" Foreground="#D4D4D8" TextWrapping="Wrap" LineHeight="20"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding DebugModeEnabled}" Content="Modo Debug (Salvar capturas)" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <Button Command="{Binding ClearLogsCommand}" Content="Limpar Logs" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                            <Button Command="{Binding TestLocalImageCommand}" Content="Testar Imagem Local" Style="{StaticResource ModernButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- LOGS TERMINAL -->
        <Border Grid.Row="3" Background="#09090B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="TERMINAL DE LOGS EM TEMPO REAL" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,8"/>

                <ListBox x:Name="LogListBox" Grid.Row="1" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#A1A1AA" FontFamily="Consolas" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#A1A1AA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                                                <Setter Property="Foreground" Value="#34D399"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                <Setter Property="Foreground" Value="#F87171"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <StatusBar Grid.Row="4" Background="#18181B" Foreground="#71717A" Padding="8,4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Foreground="#D4D4D8" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
